# Copy this file to .env for local development and fill in real values.
# NEVER commit the actual .env file (it is already in .gitignore).
# In production (Render), set these as Environment Variables in the dashboard instead of a file.

# Postgres connection string, e.g. from Neon:
# postgresql://user:password@host/dbname?sslmode=require
DB_CONNECTION=postgresql://user:password@localhost:5432/task_management

# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

ALGORITHM=HS256
EXP_TIME=60
